{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "mxv/preflight/v1",
  "description": "Each secret that the workspace's manifest declares, whether its check command worked, and for each one that did not, the command line that signs in.",
  "type": "object",
  "properties": {
    "schema": {
      "description": "The id of this document.",
      "const": "mxv/preflight/v1"
    },
    "dry_run": {
      "description": "Present, and true, when the run was a dry run that changed nothing.",
      "const": true
    },
    "data": {
      "$ref": "#/$defs/PreflightResult"
    },
    "failures": {
      "description": "The failures that the answer leaves out. It is empty when nothing failed.",
      "type": "array",
      "items": {
        "description": "A failure of some of the ids: the fields of the failure document without schema.",
        "type": "object",
        "properties": {
          "sentence": {
            "description": "A fixed sentence that a person reviewed, safe to show to anyone. It is present only when the failure has one.",
            "type": "string"
          },
          "key": {
            "description": "The key that the caller gave for the answer that failed, when the failure is one answer of a batch.",
            "type": "string"
          },
          "index": {
            "description": "The position of key among the keys that the caller gave, counted from 0, so two failures of the same key differ. It is present only with key.",
            "type": "integer",
            "minimum": 0
          },
          "code": {
            "description": "The failure's stable code, such as shelf::books::not_found. It is one or more printable ASCII characters without spaces, from ! to ~.",
            "type": "string",
            "pattern": "^[!-~]+$"
          },
          "message": {
            "description": "What went wrong.",
            "type": "string"
          },
          "cause": {
            "description": "The errors that led to the failure, joined with \": \". It is present only when the failure has a cause.",
            "type": "string"
          },
          "causes": {
            "description": "The reasons the failure lists side by side, in order, one sentence each. It is present only when the failure lists at least one.",
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "fields": {
            "description": "The values at fault, in the order the failure gives them, each under a name of one or more lowercase ASCII letters, digits and underscores. A value is a string, an integer, a boolean, null, or an array or object of such values, and an object holds each key once. It is present only when the failure names at least one.",
            "type": "object",
            "propertyNames": {
              "pattern": "^[a-z0-9_]+$"
            },
            "additionalProperties": {
              "type": [
                "string",
                "integer",
                "boolean",
                "null",
                "array",
                "object"
              ],
              "$anchor": "field_value",
              "items": {
                "$ref": "#field_value"
              },
              "additionalProperties": {
                "$ref": "#field_value"
              }
            }
          },
          "labels": {
            "description": "The places in a source, such as a file, that the failure points at, in the order the failure gives them. It is present only when the failure has at least one label.",
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "offset": {
                  "description": "The byte offset of the start of the span from the start of the source.",
                  "type": "integer",
                  "minimum": 0
                },
                "length": {
                  "description": "The length of the span in bytes.",
                  "type": "integer",
                  "minimum": 0
                },
                "name": {
                  "description": "The name of the source, such as a file name. It is present only when the span could be read and the source has a name.",
                  "type": "string"
                },
                "line": {
                  "description": "The 1-based line that holds the start of the span. It is present only when the span could be read.",
                  "type": "integer",
                  "minimum": 1
                },
                "column": {
                  "description": "The 1-based column of the start of the span, counted in characters of its line. It is present only when the span could be read.",
                  "type": "integer",
                  "minimum": 1
                },
                "excerpt": {
                  "description": "The lines of the source that the span covers, with one line before and one after where the source has them. It is present only when the span could be read.",
                  "type": "object",
                  "properties": {
                    "line": {
                      "description": "The 1-based number of the first line of the excerpt.",
                      "type": "integer",
                      "minimum": 1
                    },
                    "text": {
                      "description": "The lines, joined by the line breaks of the source, without a line break at the end.",
                      "type": "string"
                    }
                  },
                  "required": [
                    "line",
                    "text"
                  ]
                },
                "text": {
                  "description": "What the label says about the span. It is present only when the label has text.",
                  "type": "string"
                }
              },
              "required": [
                "offset",
                "length"
              ]
            }
          },
          "related": {
            "description": "The diagnostics that the failure's diagnostic relates to it, in the order it gives them. It is present only when there is at least one.",
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "message": {
                  "description": "What the related diagnostic says.",
                  "type": "string"
                },
                "code": {
                  "description": "The related diagnostic's own code, which is free text. It is present only when the diagnostic has one.",
                  "type": "string"
                },
                "severity": {
                  "description": "How severe the related diagnostic is. A diagnostic that gives no severity is an error.",
                  "enum": [
                    "error",
                    "warning",
                    "advice"
                  ]
                },
                "cause": {
                  "description": "The errors below the related diagnostic, joined with \": \". It is present only when there is one.",
                  "type": "string"
                },
                "labels": {
                  "description": "The places in a source, such as a file, that the failure points at, in the order the failure gives them. It is present only when the failure has at least one label.",
                  "type": "array",
                  "items": {
                    "type": "object",
                    "properties": {
                      "offset": {
                        "description": "The byte offset of the start of the span from the start of the source.",
                        "type": "integer",
                        "minimum": 0
                      },
                      "length": {
                        "description": "The length of the span in bytes.",
                        "type": "integer",
                        "minimum": 0
                      },
                      "name": {
                        "description": "The name of the source, such as a file name. It is present only when the span could be read and the source has a name.",
                        "type": "string"
                      },
                      "line": {
                        "description": "The 1-based line that holds the start of the span. It is present only when the span could be read.",
                        "type": "integer",
                        "minimum": 1
                      },
                      "column": {
                        "description": "The 1-based column of the start of the span, counted in characters of its line. It is present only when the span could be read.",
                        "type": "integer",
                        "minimum": 1
                      },
                      "excerpt": {
                        "description": "The lines of the source that the span covers, with one line before and one after where the source has them. It is present only when the span could be read.",
                        "type": "object",
                        "properties": {
                          "line": {
                            "description": "The 1-based number of the first line of the excerpt.",
                            "type": "integer",
                            "minimum": 1
                          },
                          "text": {
                            "description": "The lines, joined by the line breaks of the source, without a line break at the end.",
                            "type": "string"
                          }
                        },
                        "required": [
                          "line",
                          "text"
                        ]
                      },
                      "text": {
                        "description": "What the label says about the span. It is present only when the label has text.",
                        "type": "string"
                      }
                    },
                    "required": [
                      "offset",
                      "length"
                    ]
                  }
                },
                "help": {
                  "description": "The related diagnostic's advice. It is present only when it gives some.",
                  "type": "string"
                },
                "url": {
                  "description": "A page that explains the related diagnostic. It is present only when it has one.",
                  "type": "string"
                },
                "related": {
                  "description": "The diagnostics related to this one, in the same shape, to at most eight levels below the failure.",
                  "type": "array",
                  "items": {
                    "$ref": "#related"
                  }
                }
              },
              "$anchor": "related",
              "required": [
                "message",
                "severity"
              ]
            }
          },
          "recovery": {
            "description": "What the caller can do next, tagged by kind.",
            "oneOf": [
              {
                "description": "Run this command. With `all`, run it once with every value of the failure's field that `all` names in place of the argument's placeholder, such as `<ID>...`.",
                "type": "object",
                "properties": {
                  "kind": {
                    "const": "run"
                  },
                  "call": {
                    "type": "string"
                  },
                  "all": {
                    "type": "string"
                  }
                },
                "required": [
                  "kind",
                  "call"
                ]
              },
              {
                "description": "A person must run this command in a terminal, so a program should hand the step to a person.",
                "type": "object",
                "properties": {
                  "kind": {
                    "const": "terminal"
                  },
                  "call": {
                    "type": "string"
                  }
                },
                "required": [
                  "kind",
                  "call"
                ]
              },
              {
                "description": "Run this command of another program. `run` is the quoted command line that the text output prints.",
                "type": "object",
                "properties": {
                  "kind": {
                    "const": "program"
                  },
                  "program": {
                    "type": "string"
                  },
                  "args": {
                    "type": "array",
                    "items": {
                      "type": "string"
                    }
                  },
                  "run": {
                    "type": "string"
                  }
                },
                "required": [
                  "kind",
                  "program",
                  "args",
                  "run"
                ]
              },
              {
                "description": "Run the same command again later.",
                "type": "object",
                "properties": {
                  "kind": {
                    "const": "retry"
                  }
                },
                "required": [
                  "kind"
                ]
              },
              {
                "description": "Make this repair, then take the step `then`.",
                "type": "object",
                "properties": {
                  "kind": {
                    "const": "after"
                  },
                  "repair": {
                    "type": "string"
                  },
                  "then": {
                    "description": "The step that follows the repair.",
                    "oneOf": [
                      {
                        "description": "Run this command. With `all`, run it once with every value of the failure's field that `all` names in place of the argument's placeholder, such as `<ID>...`.",
                        "type": "object",
                        "properties": {
                          "kind": {
                            "const": "run"
                          },
                          "call": {
                            "type": "string"
                          },
                          "all": {
                            "type": "string"
                          }
                        },
                        "required": [
                          "kind",
                          "call"
                        ]
                      },
                      {
                        "description": "A person must run this command in a terminal, so a program should hand the step to a person.",
                        "type": "object",
                        "properties": {
                          "kind": {
                            "const": "terminal"
                          },
                          "call": {
                            "type": "string"
                          }
                        },
                        "required": [
                          "kind",
                          "call"
                        ]
                      },
                      {
                        "description": "Run the same command again later.",
                        "type": "object",
                        "properties": {
                          "kind": {
                            "const": "retry"
                          }
                        },
                        "required": [
                          "kind"
                        ]
                      }
                    ]
                  }
                },
                "required": [
                  "kind",
                  "repair",
                  "then"
                ]
              },
              {
                "description": "Follow this advice.",
                "type": "object",
                "properties": {
                  "kind": {
                    "const": "hint"
                  },
                  "text": {
                    "type": "string"
                  }
                },
                "required": [
                  "kind",
                  "text"
                ]
              },
              {
                "description": "There is no next step, for this reason.",
                "type": "object",
                "properties": {
                  "kind": {
                    "const": "none"
                  },
                  "reason": {
                    "type": "string"
                  }
                },
                "required": [
                  "kind",
                  "reason"
                ]
              }
            ]
          },
          "alternatives": {
            "description": "Other repairs the caller can try, in order of preference, each in the shape of recovery. It is present only when the failure offers at least one.",
            "type": "array",
            "items": {
              "description": "A repair the caller can try instead, tagged by kind.",
              "oneOf": [
                {
                  "description": "Run this command. With `all`, run it once with every value of the failure's field that `all` names in place of the argument's placeholder, such as `<ID>...`.",
                  "type": "object",
                  "properties": {
                    "kind": {
                      "const": "run"
                    },
                    "call": {
                      "type": "string"
                    },
                    "all": {
                      "type": "string"
                    }
                  },
                  "required": [
                    "kind",
                    "call"
                  ]
                },
                {
                  "description": "A person must run this command in a terminal, so a program should hand the step to a person.",
                  "type": "object",
                  "properties": {
                    "kind": {
                      "const": "terminal"
                    },
                    "call": {
                      "type": "string"
                    }
                  },
                  "required": [
                    "kind",
                    "call"
                  ]
                },
                {
                  "description": "Run this command of another program. `run` is the quoted command line that the text output prints.",
                  "type": "object",
                  "properties": {
                    "kind": {
                      "const": "program"
                    },
                    "program": {
                      "type": "string"
                    },
                    "args": {
                      "type": "array",
                      "items": {
                        "type": "string"
                      }
                    },
                    "run": {
                      "type": "string"
                    }
                  },
                  "required": [
                    "kind",
                    "program",
                    "args",
                    "run"
                  ]
                },
                {
                  "description": "Run the same command again later.",
                  "type": "object",
                  "properties": {
                    "kind": {
                      "const": "retry"
                    }
                  },
                  "required": [
                    "kind"
                  ]
                },
                {
                  "description": "Make this repair, then take the step `then`.",
                  "type": "object",
                  "properties": {
                    "kind": {
                      "const": "after"
                    },
                    "repair": {
                      "type": "string"
                    },
                    "then": {
                      "description": "The step that follows the repair.",
                      "oneOf": [
                        {
                          "description": "Run this command. With `all`, run it once with every value of the failure's field that `all` names in place of the argument's placeholder, such as `<ID>...`.",
                          "type": "object",
                          "properties": {
                            "kind": {
                              "const": "run"
                            },
                            "call": {
                              "type": "string"
                            },
                            "all": {
                              "type": "string"
                            }
                          },
                          "required": [
                            "kind",
                            "call"
                          ]
                        },
                        {
                          "description": "A person must run this command in a terminal, so a program should hand the step to a person.",
                          "type": "object",
                          "properties": {
                            "kind": {
                              "const": "terminal"
                            },
                            "call": {
                              "type": "string"
                            }
                          },
                          "required": [
                            "kind",
                            "call"
                          ]
                        },
                        {
                          "description": "Run the same command again later.",
                          "type": "object",
                          "properties": {
                            "kind": {
                              "const": "retry"
                            }
                          },
                          "required": [
                            "kind"
                          ]
                        }
                      ]
                    }
                  },
                  "required": [
                    "kind",
                    "repair",
                    "then"
                  ]
                },
                {
                  "description": "Follow this advice.",
                  "type": "object",
                  "properties": {
                    "kind": {
                      "const": "hint"
                    },
                    "text": {
                      "type": "string"
                    }
                  },
                  "required": [
                    "kind",
                    "text"
                  ]
                },
                {
                  "description": "There is no next step, for this reason.",
                  "type": "object",
                  "properties": {
                    "kind": {
                      "const": "none"
                    },
                    "reason": {
                      "type": "string"
                    }
                  },
                  "required": [
                    "kind",
                    "reason"
                  ]
                }
              ]
            }
          },
          "url": {
            "description": "A page that explains the failure. It is present only when the failure has one.",
            "type": "string"
          }
        },
        "required": [
          "code",
          "message",
          "recovery"
        ]
      }
    }
  },
  "required": [
    "schema",
    "data",
    "failures"
  ],
  "$defs": {
    "PreflightResult": {
      "description": "What `mxv preflight` found.",
      "type": "object",
      "properties": {
        "workspace": {
          "description": "The workspace's name.",
          "type": "string"
        },
        "state": {
          "description": "Whether the workspace can start work.",
          "$ref": "#/$defs/PreflightState"
        },
        "secrets": {
          "description": "Each secret, in name order.",
          "type": "array",
          "items": {
            "$ref": "#/$defs/SecretRow"
          }
        },
        "message": {
          "description": "One message that names every sign-in the person must do, each with\nits exact command, or null when none is needed.",
          "type": [
            "string",
            "null"
          ]
        }
      },
      "required": [
        "workspace",
        "state",
        "secrets",
        "message"
      ]
    },
    "PreflightState": {
      "description": "Whether the workspace can start work.",
      "oneOf": [
        {
          "description": "Every check worked, or the manifest declares no secret.",
          "type": "string",
          "const": "ready"
        },
        {
          "description": "At least one check did not work or did not run, and the person has\nto sign in or approve it.",
          "type": "string",
          "const": "sign_in_needed"
        }
      ]
    },
    "SecretRow": {
      "description": "One secret and what its check showed.",
      "type": "object",
      "properties": {
        "name": {
          "description": "The secret's name in the manifest.",
          "type": "string"
        },
        "works": {
          "description": "Whether the check command exited with 0.",
          "type": "boolean"
        },
        "reason": {
          "description": "Why the check did not work, or null when it did: `failed`,\n`unrunnable` when the program does not start, `timed_out` when the\ncommand was still running after 20 seconds and mxv stopped it, or\n`not_approved` when no one approved the command and mxv did not run\nit.",
          "anyOf": [
            {
              "$ref": "#/$defs/Reason"
            },
            {
              "type": "null"
            }
          ]
        },
        "sign_in": {
          "description": "The command line that signs in, which the manifest declares.",
          "type": "string"
        }
      },
      "required": [
        "name",
        "works",
        "reason",
        "sign_in"
      ]
    },
    "Reason": {
      "description": "Why a check did not work.",
      "oneOf": [
        {
          "description": "The command exited with another code or a signal.",
          "type": "string",
          "const": "failed"
        },
        {
          "description": "The program does not start.",
          "type": "string",
          "const": "unrunnable"
        },
        {
          "description": "The command was still running at the timeout.",
          "type": "string",
          "const": "timed_out"
        },
        {
          "description": "No one approved the command line.",
          "type": "string",
          "const": "not_approved"
        }
      ]
    }
  }
}
